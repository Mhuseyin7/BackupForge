# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BACKUPFORGE_MASTER_KEY=
BACKUPFORGE_AUTH_SECRET=
BACKUPFORGE_DATABASE_URL=postgresql+psycopg://backupforge:change-me@postgres:5432/backupforge
BACKUPFORGE_REDIS_URL=redis://redis:6379/0
BACKUPFORGE_DATA_DIR=/var/lib/backupforge
BACKUPFORGE_ALLOWED_SOURCE_ROOTS=/data
BACKUPFORGE_ALLOWED_RESTORE_ROOTS=/restore
