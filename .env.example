# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BACKUPFORGE_MASTER_KEY=
BACKUPFORGE_AUTH_SECRET=
# One-time first-owner registration authorization. Keep outside the database.
BACKUPFORGE_BOOTSTRAP_TOKEN=
BACKUPFORGE_DATABASE_URL=postgresql+psycopg://backupforge:change-me@postgres:5432/backupforge
BACKUPFORGE_REDIS_URL=redis://redis:6379/0
BACKUPFORGE_DATA_DIR=/var/lib/backupforge
BACKUPFORGE_ALLOWED_SOURCE_ROOTS=/data
BACKUPFORGE_ALLOWED_RESTORE_ROOTS=/restore
BACKUPFORGE_ALLOWED_DESTINATION_ROOTS=/var/lib/backupforge/storage
# Keep false unless this is a dedicated, reviewed worker with Docker access.
BACKUPFORGE_ENABLE_DOCKER_VERIFICATION=false
# Required when the corresponding Docker feature is enabled; use immutable digest references only.
BACKUPFORGE_DOCKER_VOLUME_HELPER_IMAGE=
BACKUPFORGE_POSTGRES_VERIFICATION_IMAGE=
BACKUPFORGE_CORS_ORIGINS=http://localhost:3000
